name:                server
version:             0.1.0.0
synopsis:            Production-grade Servant web server
description:         A Servant web application with production best practices
category:            Web
license:             MIT
license-file:       LICENSE
author:              The Benchmarker Team
maintainer:          team@benchmark.com
build-type:          Simple
cabal-version:       >=1.10

library
  hs-source-dirs:      src
  exposed-modules:     Lib
  
  -- Language extensions for modern Haskell
  default-extensions:  DataKinds
                      TypeOperators
                      OverloadedStrings
                      DeriveGeneric
                      FlexibleContexts
  
  -- Production dependencies with version bounds
  build-depends:       base >= 4.15 && < 5
                     , servant >= 0.20 && < 0.22
                     , servant-server >= 0.20 && < 0.22
                     , wai >= 3.2 && < 4
                     , warp >= 3.3 && < 4
                     , text >= 1.2 && < 3
                     , aeson >= 2.0 && < 3
                     , bytestring >= 0.11 && < 0.12
                     , wai-cors >= 0.2 && < 0.3
                     , wai-middleware-gzip >= 0.0 && < 0.1
                     , wai-middleware-request-size-limit >= 0.1 && < 0.2
  
  default-language:    Haskell2010

executable server
  hs-source-dirs:      app
  main-is:             Main.hs
  
  -- Production-grade GHC options
  -- -Wall: Enable all warnings
  -- -Werror: Treat warnings as errors for production
  -- -threaded: Enable threaded runtime for better performance
  -- -O2: Maximum optimization
  -- -rtsopts: Enable runtime system options
  -- -with-rtsopts=-N: Use number of processors as capabilities
  -- -with-rtsopts=-A64M: Generational GC with 64MB allocation area
  -- -funbox-strict-fields: Optimize strict fields
  ghc-options:         -Wall -Werror -threaded -O2 -rtsopts -with-rtsopts=-N -with-rtsopts=-A64M -funbox-strict-fields
  
  -- Language extensions for modern Haskell
  default-extensions:  OverloadedStrings
  
  -- Dependencies
  build-depends:       base >= 4.15 && < 5
                     , server
  
  default-language:    Haskell2010
