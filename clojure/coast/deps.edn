{:paths ["src/main/clojure" "classes"]

 :deps {coast-framework/coast {:mvn/version "0.1.0-SNAPSHOT"}
        org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}

 :aliases {:outdated {:extra-deps {olical/depot {:mvn/version "2.4.1"}}
                      :main-opts ["-m" "depot.outdated.main"
                                  "-a" "outdated"]}
           :uberjar {:extra-deps {uberdeps/uberdeps {:mvn/version "1.4.0"}}
                     :main-opts ["-m" "uberdeps.uberjar"
                                 "--target" "coast.jar"]}
           :prod {:jvm-opts ["-Xms256m" "-Xmx512m" "-XX:+UseG1GC" "-XX:MaxGCPauseMillis=200"]}}}
