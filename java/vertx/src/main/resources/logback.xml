<?xml version="1.0" encoding="UTF-8"?>
<!--
  Production-grade Logback configuration for Vert.x benchmark application
  
  Features:
  - WARN level logging by default (minimal overhead)
  - Errors logged to both console and file
  - Async logging for better performance
  - No debug logging in production
  - Console output disabled by default (can be enabled via environment variable)
-->
<configuration scan="true" scanPeriod="30 seconds">
    
    <!-- Application name -->
    <property name="APP_NAME" value="vertx-benchmark" />
    
    <!-- Log level - can be overridden via system property -->
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-WARN}" />
    
    <!-- Enable console logging - can be overridden via environment variable -->
    <property name="CONSOLE_LOGGING" value="${CONSOLE_LOGGING:-false}" />
    
    <!-- Log file location -->
    <property name="LOG_FILE" value="${LOG_FILE:-/var/log/vertx-benchmark.log}" />
    
    <!-- Log pattern -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    
    <!-- Console appender - only enabled if CONSOLE_LOGGING is true -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <withJansi>false</withJansi>
    </appender>
    
    <!-- File appender for errors only -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep logs for 7 days -->
            <maxHistory>7</maxHistory>
            <!-- Total size cap -->
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <!-- Only log ERROR and above to file -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>
    
    <!-- Async appender for better performance -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <!-- Include reference to Console appender -->
        <appender-ref ref="CONSOLE" />
        <!-- Include reference to File appender -->
        <appender-ref ref="FILE" />
        <!-- Queue size -->
        <queueSize>1000</queueSize>
        <!-- Discard events if queue is full -->
        <discardingThreshold>0</discardingThreshold>
        <!-- Include caller data -->
        <includeCallerData>true</includeCallerData>
    </appender>
    
    <!-- Root logger -->
    <root level="${LOG_LEVEL}">
        <!-- Console appender only if enabled -->
        <if condition='property("CONSOLE_LOGGING").equalsIgnoreCase("true")'>
            <then>
                <appender-ref ref="ASYNC" />
            </then>
        </if>
        <!-- Always log errors to file -->
        <appender-ref ref="FILE" />
    </root>
    
    <!-- Vert.x specific logger - minimal logging -->
    <logger name="io.vertx" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="FILE" />
    </logger>
    
    <!-- Benchmark application logger -->
    <logger name="benchmark" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="FILE" />
    </logger>
    
    <!-- Netty logger - minimal logging -->
    <logger name="io.netty" level="WARN" additivity="false">
        <appender-ref ref="FILE" />
    </logger>
    
    <!-- Disable JUL to Logback bridge to avoid duplicate logging -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>
</configuration>
