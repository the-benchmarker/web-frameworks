{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":preserveSemverRanges"],
  "separateMultipleMajor": true,
  "reviewers": ["waghanza"],
  "postUpgradeTasks": {
    "commands": [
      "ruby .github/scripts/update-renovate-config-version.rb",
      "ruby .github/scripts/sync-language-versions.rb"
    ],
    "dataFileTemplate": "{{{toJSON upgrades}}}",
    "executionMode": "branch",
    "fileFilters": ["**/config.yaml"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub-hosted Crystal shards",
      "managerFilePatterns": ["/(^|/)shard\\.yml$/"],
      "matchStrings": [
        "(?:^|\\r\\n|\\r|\\n)[ \\t]+(?<depName>[\\w.-]+):[ \\t]*\\r?\\n[ \\t]+github:[ \\t]*(?<packageName>[^\\s#]+)[ \\t]*\\r?\\n[ \\t]+version:[ \\t]*~>[ \\t]*(?<currentValue>\\d+(?:\\.\\d+){1,2})"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>\\d+(?:\\.\\d+){1,2})$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["next"],
      "groupName": "Next.js"
    }
  ]
}
