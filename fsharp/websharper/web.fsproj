<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WebSharperProject>web</WebSharperProject>
    <WebProjectOutputDir>$(MSBuildThisFileDirectory)/wwwroot</WebProjectOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Main.fs" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WebSharper.Core" Version="10.1.*" />
    <PackageReference Include="WebSharper" Version="10.1.*" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.*" />
    <PackageReference Include="WebSharper.AspNetCore" Version="10.1.*" />
  </ItemGroup>

</Project>
