<Project Sdk="Microsoft.NET.Sdk.Web">
  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>frank-web</AssemblyName>
    <RootNamespace>FrankWeb</RootNamespace>
    
    <!-- Production optimizations -->
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    
    <!-- Security -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    
    <!-- Docker support -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileFastBuild>True</DockerfileFastBuild>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' = 'Release'">
    <NoWarn>$(NoWarn);40;1701;1702;1705;3572</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Frank" Version="6.3.*" />
    <PackageReference Include="Microsoft.AspNetCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
  </ItemGroup>
  
  <!-- Metadata -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>Production-grade Frank web server with security best practices</Description>
    <Authors>Your Organization</Authors>
    <Company>Your Company</Company>
    <Product>Frank Web Server</Product>
    <Copyright>Copyright © $(GetCurrentDateTime:"yyyy") Your Company</Copyright>
    <RepositoryUrl>https://github.com/your-org/frank-web</RepositoryUrl>
    <PackageTags>web;server;frank;fsharp;production</PackageTags>
  </PropertyGroup>
</Project>
